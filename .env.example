# MongoDB Atlas Connection URI (Isolated Coordinators Database)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/coordinator_certificate_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.mongodb.net/coordinator_certificate_db?retryWrites=true&w=majority
MONGODB_DB_NAME=coordinator_certificate_db

# Server Port (Runs on 3001 for Web 2)
PORT=3001

# Security
JWT_SECRET=super_secret_certificate_jwt_key_2026

# Admin Credentials (automatically seeded/synced on database connect)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin@123

ADMIN_USER=hari
ADMIN_PASS=@Meerayya@123

